{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"rewriteRelativeImportExtensions": true,
		"sourceMap": true,
		"strict": true,
		"skipLibCheck": true,
		"types": ["$app/types", "./worker-configuration.d.ts"],
		"paths": {
			"#lib": ["./src/lib/index.ts"],
			"#lib/*": ["./src/lib/*"]
		}
	},
	"include": ["src"],
	"exclude": [
		"node_modules/**",
		".svelte-kit/output/**",
		".svelte-kit/cloudflare/**",
		".svelte-kit/cloudflare-tmp/**"
	]
}
